{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "packageRules": [
        {
            "description": "No update cooldown for internal coopnorge js packages",
            "minimumReleaseAge": "0 days",
            "prCreation": "immediate",
            "matchDatasources": [
                "npm"
            ],
            "matchPackageNames": [
                "@coopnorge/**",
            ]
        },
        {
            "description": "Group react-router and react-router-dom npm packages updates together",
            "groupName": "react-router",
            "groupSlug": "terraform-google-providersreact-router",
            "matchDatasources": [
                "npm"
            ],
            "matchPackageNames": [
                "react-router",
                "react-router-dom",
            ],
        }
    ],
}
