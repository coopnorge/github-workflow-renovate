{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "packageRules": [
        {
            "matchManagers": [
                "github-actions",
            ],
            "pinDigests": true,
            "matchPackageNames": [
                "!actions/**",
                "!coopnorge/**",
            ],
        },
        {
            "description": "No update cooldown for internal coopnorge actions and releases",
            "matchDatasources": ["github-tags", "github-releases"],
            "matchPackageNames": ["coopnorge/**"],
            "minimumReleaseAge": "0 days",
            "prCreation": "immediate"
        },
    ],
}
