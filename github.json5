{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "customManagers": [
        {
            // Pin internal coopnorge workflows/actions to the latest exact tag. Floating refs such as @v0 are read as 0.0.0
            // by semver-coerced versioning, so they are tracked as v0. @main has no version, so it is also treated as v0.
            //
            // Both forms share one manager. The autoReplace step re-extracts the rewritten file with this same manager,
            // so a separate @main manager would find nothing after @main is rewritten to a tag, and the rebase would fail.
            "customType": "regex",
            "managerFilePatterns": [
                "/^\\.github/(workflows|actions)/.+\\.ya?ml$/",
            ],
            "matchStrings": [
                "uses:\\s*(?<prefix>(?<depName>coopnorge/[^/@\\s]+)[^@\\s]*)@(?:main|(?<currentValue>v\\d[^\\s]*))",
            ],
            "currentValueTemplate": "{{#if currentValue}}{{{currentValue}}}{{else}}v0{{/if}}",
            "datasourceTemplate": "github-tags",
            "versioningTemplate": "semver-coerced",
            "autoReplaceStringTemplate": "uses: {{{prefix}}}@{{{newValue}}}",
        },
        {
            // Track the main branch of internal coopnorge workflows/actions pinned to a SHA: `@<sha> # main`.
            // The SHA is bumped to the latest commit on main, and the `# main` comment is kept.
            //
            // Don't add an autoReplaceStringTemplate here. Custom capture groups such as `path`
            // aren't available in the template, so the workflow path can end up being dropped from the result.
            // The default replacement only swaps the digest and leaves the rest of the line alone.
            "customType": "regex",
            "managerFilePatterns": [
                "/^\\.github/(workflows|actions)/.+\\.ya?ml$/",
            ],
            "matchStrings": [
                "uses:\\s*(?<depName>coopnorge/[^/@\\s]+)(?<path>/[^@\\s]*)?@(?<currentDigest>[a-f0-9]{40})\\s+#\\s+(?<currentValue>main)\\b",
            ],
            "datasourceTemplate": "github-digest",
            "versioningTemplate": "git",
        },
    ],
    "packageRules": [
        {
            "matchManagers": [
                "github-actions",
            ],
            "pinDigests": true,
            "matchPackageNames": [
                "!coopnorge/**",
            ],
        },
        {
            "description": "Internal coopnorge refs are handled by the custom regex managers",
            "matchManagers": ["github-actions"],
            "matchPackageNames": ["coopnorge/**"],
            "enabled": false,
        },
        {
            "description": "No update cooldown for internal coopnorge actions and releases",
            "matchDatasources": ["github-tags", "github-releases", "github-digest"],
            "matchPackageNames": ["coopnorge/**"],
            "minimumReleaseAge": null, // 0 days
            "prCreation": "immediate"
        },
        {
            // config:recommended adds a "[changelog]({{sourceUrl}}/compare/<old>..<new>)" link for digest updates,
            // but sourceUrl is empty before this rule. Set it, and also label the diffs as "changes".
            "description": "Link internal coopnorge digest updates to the commit diff",
            "matchDatasources": ["github-digest"],
            "matchPackageNames": ["coopnorge/**"],
            "matchUpdateTypes": ["digest"],
            "sourceUrl": "https://github.com/{{{packageName}}}",
            "prBodyDefinitions": {
                "Package": "[{{{depName}}}]({{{sourceUrl}}}) ([changes]({{{sourceUrl}}}/compare/{{{currentDigest}}}..{{{newDigest}}}))"
            },
        },
    ],
}
