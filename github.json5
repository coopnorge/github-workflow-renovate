{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "customManagers": [
        {
            // Pin internal coopnorge workflows/actions: @vX and @vX.Y.Z are tracked against github-tags.
            // Floating refs such as @v0 are read as 0.0.0 by semver-coerced versioning, so they are pinned to the latest exact tag.
            "customType": "regex",
            "managerFilePatterns": [
                "/^\\.github/(workflows|actions)/.+\\.ya?ml$/",
            ],
            "matchStrings": [
                "uses:\\s*(?<depName>coopnorge/[^/@\\s]+)(?<path>/[^@\\s]*)?@(?<currentValue>v\\d[^\\s]*)",
            ],
            "datasourceTemplate": "github-tags",
            "versioningTemplate": "semver-coerced",
        },
        {
            // @main has no version. Treat it as v0 so it is pinned to the latest exact tag, keeping the path.
            "customType": "regex",
            "managerFilePatterns": [
                "/^\\.github/(workflows|actions)/.+\\.ya?ml$/",
            ],
            "matchStrings": [
                "uses:\\s*(?<prefix>(?<depName>coopnorge/[^/@\\s]+)[^@\\s]*)@main",
            ],
            "currentValueTemplate": "v0",
            "datasourceTemplate": "github-tags",
            "versioningTemplate": "semver-coerced",
            "autoReplaceStringTemplate": "uses: {{{prefix}}}@{{{newValue}}}",
        },
        {
            // Track the main branch of internal coopnorge workflows/actions pinned to a SHA: `@<sha> # main`.
            // The SHA is bumped to the latest commit on main, and the `# main` comment is kept.
            //
            // Don't add an autoReplaceStringTemplate here. Custom capture groups such as `path`
            // aren't available in the template, so the workflow path can end up being dropped from the result.
            // The default replacement only swaps the digest and leaves the rest of the line alone.
            "customType": "regex",
            "managerFilePatterns": [
                "/^\\.github/(workflows|actions)/.+\\.ya?ml$/",
            ],
            "matchStrings": [
                "uses:\\s*(?<depName>coopnorge/[^/@\\s]+)(?<path>/[^@\\s]*)?@(?<currentDigest>[a-f0-9]{40})\\s+#\\s+(?<currentValue>main)\\b",
            ],
            "datasourceTemplate": "github-digest",
            "versioningTemplate": "git",
        },
    ],
    "packageRules": [
        {
            "matchManagers": [
                "github-actions",
            ],
            "pinDigests": true,
            "matchPackageNames": [
                "!coopnorge/**",
            ],
        },
        {
            "description": "Internal coopnorge refs are handled by the custom regex managers",
            "matchManagers": ["github-actions"],
            "matchPackageNames": ["coopnorge/**"],
            "enabled": false,
        },
        {
            "description": "No update cooldown for internal coopnorge actions and releases",
            "matchDatasources": ["github-tags", "github-releases", "github-digest"],
            "matchPackageNames": ["coopnorge/**"],
            "minimumReleaseAge": null, // 0 days
            "prCreation": "immediate"
        },
    ],
}
