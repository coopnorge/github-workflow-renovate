{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "packageRules": [
        {
            "description": "No update cooldown for internal coopnorge modules",
            "minimumReleaseAge": null, // 0 days
            "prCreation": "immediate",
            "matchDatasources": [
                "go"
            ],
            "matchPackageNames": [
                "github.com/coopnorge/**"
            ]
        },
        {
            "groupName": "dd-trace-go packages",
            "groupSlug": "dd-trace-go",
            "matchDatasources": [
                "go"
            ],
            "matchPackageNames": [
                "github.com/DataDog/dd-trace-go/**"
            ]
        },
        {
            "groupName": "echo go packages",
            "groupSlug": "echo-go",
            "matchDatasources": [
                "go"
            ],
            "matchPackageNames": [
                "github.com/labstack/echo",
                "github.com/labstack/echo-*"
            ]
        },
        {
            "description": "Separate group for internal coopnorge mage so branch renovate/coopnorge-mage identifies internal-only updates",
            "groupName": "coopnorge mage",
            "groupSlug": "coopnorge-mage",
            "matchDatasources": [
                "go",
                "github-tags", // GitHub workflow/action
            ],
            "matchPackageNames": [
                "github.com/coopnorge/mage",
                "coopnorge/mage", // GitHub workflow/action
            ],
        },
        {
            "groupName": "golang x-packages",
            "groupSlug": "golang-x-packages",
            "matchDatasources": [
                "go",
            ],
            "matchPackageNames": [
                "golang.org/x/*",
            ],
        },
        {
            "description": "Bump the go directive version in go.mod",
            "matchManagers": ["gomod"],
            "matchDepNames": ["go"],
            "matchDepTypes": ["golang"],
            "rangeStrategy": "bump",
        },
        {
            "description": "Group the go directive in go.mod with the golang Docker image so go.mod never requires a newer Go than the image provides",
            "groupName": "go version",
            "groupSlug": "go-version",
            "matchDatasources": [
                "golang-version", // go directive in go.mod
                "docker", // golang image in Dockerfiles
            ],
            "matchDepNames": [
                "go",
                "golang",
            ],
            // With the default "strict", an update still within minimumReleaseAge is left out of the group, so go.mod
            // could be updated without the image. "none" keeps it in, so the PR waits until both updates are old enough.
            "internalChecksFilter": "none",
        },
    ]
}
