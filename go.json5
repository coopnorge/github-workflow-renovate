{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "customManagers": [
        {
            // Track coopnorge/mage version in GitHub Actions workflow files so it is grouped with the go.mod update.
            "customType": "regex",
            "managerFilePatterns": [
                "/^\\.github/(workflows|actions)/.+\\.yaml$/",
            ],
            "matchStrings": [
                "coopnorge/mage/[^@]+@(?<currentValue>v[^\\s\\n]+)",
            ],
            "depNameTemplate": "coopnorge/mage",
            "datasourceTemplate": "github-tags",
            "versioningTemplate": "semver",
        },
    ],
    "packageRules": [
        {
            "description": "No update cooldown for internal coopnorge modules",
            "minimumReleaseAge": null, // 0 days
            "prCreation": "immediate",
            "matchDatasources": [
                "go"
            ],
            "matchPackageNames": [
                "github.com/coopnorge/**"
            ]
        },
        {
            "groupName": "dd-trace-go packages",
            "groupSlug": "dd-trace-go",
            "matchDatasources": [
                "go"
            ],
            "matchPackageNames": [
                "github.com/DataDog/dd-trace-go/**"
            ]
        },
        {
            "groupName": "echo go packages",
            "groupSlug": "echo-go",
            "matchDatasources": [
                "go"
            ],
            "matchPackageNames": [
                "github.com/labstack/echo",
                "github.com/labstack/echo-*"
            ]
        },
        {
            "groupName": "mage packages",
            "groupSlug": "mage",
            "matchDatasources": [
                "go",
                "github-tags", // GitHub workflow/action
            ],
            "matchPackageNames": [
                "github.com/coopnorge/mage",
                "github.com/magefile/mage",
                "coopnorge/mage", // GitHub workflow/action
            ],
        },
        {
            "groupName": "golang x-packages",
            "groupSlug": "golang-x-packages",
            "matchDatasources": [
                "go",
            ],
            "matchPackageNames": [
                "golang.org/x/*",
            ],
        },
        {
            "description": "Bump the go directive version in go.mod",
            "matchManagers": ["gomod"],
            "matchDepNames": ["go"],
            "matchDepTypes": ["golang"],
            "rangeStrategy": "bump",
        },
    ]
}
